	(text "Operates on 38 kHz carrier frequency"
		(exclude_from_sim no)
		(at 218.44 74.93 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "3b9686e7-4e20-45df-8448-3fd5e728aee4")
	)
	(text "The rain sensor is only available on model 4500K; these components may be omitted for other models\nIt is simply a pair of electrodes that are exposed to the environment and whose impedance is about\n0.5 to 1.2 Mohm when in contact with water or mist and open circuit when dry\nWith these assumptions, the ADC should read less than ~2.9 V when wet"
		(exclude_from_sim no)
		(at 82.55 166.37 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "71a5e43d-8e49-4406-ab3e-fb72e4cda95b")
	)
	(text "Input must be 9 to 16 V\nCircuit protection\n- Internal: 4 A polyfuse, 16 V TVS, reverse polarity\n- External: 5 A fuse recommended"
		(exclude_from_sim no)
		(at 15.24 19.05 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "8043acda-6176-4c19-87e6-d330b9b6df37")
	)
	(text "Header for accessories and factory programming\n- GPIO0, GPIO1, GPIO14, GPIO15 can be used for any purpose\n- UART_RXD and UART_TXD provide the serial port\n- I2C_SCL and I2C_SDA provide the I2C bus (QWIIC)\n- RESET and BOOT are wired in parallel with their\n   corresponding buttons (active low)\n- LOCK engages the safety lock (active low)\n- ACC_ID identifies the expansion port accessory\n- 12 V supply is unregulated, 1 A current available\n- 3.3 V supply is regulated, 600 mA current available"
		(exclude_from_sim no)
		(at 15.24 166.37 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "82e2cd7f-e068-445b-9e29-a9cb59852f17")
	)
	(text "While the input is tied to ground, stops the fan,\ncloses the lid, and inhibits operation"
		(exclude_from_sim no)
		(at 149.86 120.65 0)
		(effects
