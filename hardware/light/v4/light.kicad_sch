		(exclude_from_sim no)
		(at 207.01 86.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "10be4381-106d-4e84-9e5c-ba0878837f0e")
	)
	(text "The driver can supply up to 32 mA at 5 V\n33 ohm resistor reduces signal reflections and protects the output"
		(exclude_from_sim no)
		(at 182.88 39.37 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1299f01c-295f-45e3-9c5c-aeb609578421")
	)
	(text "By default, this circuit board identifies itself to Minuet\nas a \"light accessory\" when plugged into the expansion port.\nIf you repurpose this circuit board for a different function,\nclose the `CUSTOM ACC ID` solder jumper to prevent the\nfirmware from automatically configuring the expansion GPIOs."
		(exclude_from_sim no)
		(at 35.56 133.35 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "295dc866-aaea-4811-8697-1e54dbf5bbb2")
	)
	(text "ACCESSORY IDENTIFICATION"
		(exclude_from_sim no)
		(at 35.56 130.81 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
			(justify left)
		)
		(uuid "37004751-8f34-48a5-85b3-de1d308ef4f1")
	)
	(text "Header for accessories and factory programming\n- GPIO0, GPIO1, GPIO14, GPIO15 can be used for any purpose\n- UART_RXD and UART_TXD provide the serial port\n- I2C_SCL and I2C_SDA provide the I2C bus (QWIIC)\n- RESET and BOOT are wired in parallel with their\n   corresponding buttons (active low)\n- LOCK engages the safety lock (active low)\n- ACC_ID identifies the expansion port accessory\n- 12 V supply is unregulated, 1 A current available\n- 3.3 V supply is regulated, 600 mA current available"
		(exclude_from_sim no)
		(at 35.56 39.37 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4ed9d06d-db35-4458-a9bf-ae4c55bff985")
	)
	(text "5 V LEVEL SHIFTER FOR ADDRESSABLE LED DATA"
		(exclude_from_sim no)
		(at 182.88 36.83 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
			(justify left)
		)
		(uuid "5e7c7908-6207-49c9-9d0b-c1a54a37d241")
	)
	(text "EXPANSION PORT"
		(exclude_from_sim no)
		(at 35.56 36.83 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
			(justify left)
		)
		(uuid "613182a7-b262-4aac-9aeb-1bda11cb2ce3")
	)
	(text "Supplies 150 mA, ultra low quiescent current (microamps)"
		(exclude_from_sim no)
		(at 102.87 39.37 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "aa2a8db5-96d2-4bf3-bfb5-af8b35709942")
	)
	(text "5 V POWER SUPPLY"
		(exclude_from_sim no)
		(at 102.87 36.83 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.254)
				(bold yes)
			)
			(justify left)
		)
		(uuid "b92b289c-1d24-4a4a-adb9-8ac3304f5454")
	)
